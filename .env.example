# ============================================================
# Peaffee store — copy to .env and fill in real values.
# NEVER commit .env (it is gitignored).
# ============================================================

# --- Database (docker compose builds DATABASE_URL internally) ---
DB_USER=peaffee
DB_PASSWORD=change-me
DB_NAME=peaffee

# --- Backend secrets (Spring Boot) ---
# At least 32 bytes. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string-32bytes
ADMIN_EMAIL=admin@peaffee.com
ADMIN_PASSWORD=change-me-8-chars-min
ADMIN_NAME=Peaffee Admin
BASE_URL=http://localhost

# --- SMTP email ---
# Leave SMTP_* empty to run with email logging (no real delivery).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Peaffee <concierge@peaffee.com>
ADMIN_NOTIFY_EMAIL=concierge@peaffee.com

# --- PayPal (https://developer.paypal.com) ---
# Use sandbox credentials until launch.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Register the webhook URL https://<your-domain>/api/payments/paypal/webhook
# in the PayPal dashboard and paste its Webhook ID here.
PAYPAL_WEBHOOK_ID=

# --- Western Union (offline manual method — shown to customer at checkout) ---
WU_BENEFICIARY=
WU_BANK=
WU_ACCOUNT=
WU_SWIFT=
WU_CURRENCY=USD

# --- Cloudflare R2 (image uploads; migrate from the old r2.config.json) ---
R2_ENDPOINT=
R2_BUCKET=
R2_CUSTOM_DOMAIN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
