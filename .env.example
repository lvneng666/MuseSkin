# ============================================================
# Peaffee store — copy to .env and fill in real values.
# NEVER commit .env (it is gitignored).
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# --- Database ---
# Local dev: point at your own PostgreSQL.
# Docker compose builds DATABASE_URL automatically from DB_USER/DB_PASSWORD/DB_NAME.
DATABASE_URL=postgres://peaffee:peaffee@localhost:5432/peaffee
DB_USER=peaffee
DB_PASSWORD=peaffee
DB_NAME=peaffee

# --- Session ---
# At least 16 characters. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string
# true only behind TLS (Cloudflare / reverse proxy).
COOKIE_SECURE=false
TRUST_PROXY=false

# --- Admin seed (used by `npm run db:seed`) ---
ADMIN_EMAIL=admin@peaffee.com
ADMIN_PASSWORD=change-me-8-chars-min
ADMIN_NAME=Peaffee Admin

# --- SMTP email ---
# Leave SMTP_* empty to run with email logging (no real delivery).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Peaffee <concierge@peaffee.com>
ADMIN_NOTIFY_EMAIL=concierge@peaffee.com

# --- PayPal (https://developer.paypal.com) ---
# Use sandbox credentials until launch.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Register the webhook URL https://<your-domain>/api/payments/paypal/webhook
# in the PayPal dashboard and paste its Webhook ID here.
PAYPAL_WEBHOOK_ID=

# --- Western Union (offline manual method — shown to customer at checkout) ---
WU_BENEFICIARY=
WU_BANK=
WU_ACCOUNT=
WU_SWIFT=
WU_CURRENCY=USD

# --- Cloudflare R2 (previously r2.config.json) ---
R2_ENDPOINT=
R2_BUCKET=
R2_CUSTOM_DOMAIN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
