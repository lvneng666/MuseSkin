# Standard multi-stage build for a normal CI/CD host with Maven repo access.
# For a network-restricted build host, use the default Dockerfile (copies the
# jar that was built locally via `mvn package`).
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -B -q dependency:go-offline || true
COPY src ./src
RUN mvn -B -q clean package -DskipTests

FROM eclipse-temurin:17-jre-alpine AS runtime
WORKDIR /app
ENV PORT=8080
COPY --from=build /app/target/peaffee-backend-0.1.0.jar app.jar
RUN addgroup -S app && adduser -S app -G app \
    && mkdir -p /app/uploads && chown -R app:app /app
USER app
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "java -jar /app/app.jar"]
